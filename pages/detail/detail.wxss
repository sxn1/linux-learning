.container { background: #f5f6fa; min-height: 100vh; padding-bottom: 60rpx; }

/* 头部 */
.header {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  padding: 40rpx 40rpx 56rpx;
}
.header-title { font-size: 40rpx; font-weight: 700; color: #fff; line-height: 1.4; }
.header-summary { font-size: 28rpx; color: #a0aec0; margin-top: 16rpx; line-height: 1.6; }
.header-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.htag {
  font-size: 22rpx; color: #81e6d9;
  background: rgba(129,230,217,0.15);
  padding: 6rpx 18rpx; border-radius: 20rpx;
}

/* 通用 section */
.section {
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx 32rpx 0;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.section-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx;
}
.section-header.clickable:active { background: #f7fafc; }
.sec-left { display: flex; align-items: center; gap: 14rpx; }
.sec-icon { font-size: 36rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; color: #2d3748; }
.sec-arrow { font-size: 24rpx; color: #a0aec0; transition: transform 0.2s; }
.sec-arrow.open { transform: rotate(90deg); }
.sec-body { padding: 0 32rpx 32rpx; }

/* 文本内容 */
.content-text {
  font-size: 28rpx; color: #4a5568; line-height: 1.8;
  white-space: pre-wrap; font-family: 'Courier New', monospace;
}

/* 代码块 */
.code-block {
  background: #1e1e2e; color: #cdd6f4;
  font-family: 'Courier New', monospace;
  font-size: 24rpx; padding: 24rpx;
  border-radius: 12rpx; line-height: 1.6;
  margin-top: 8rpx; white-space: pre-wrap;
}

/* 代码引用 */
.code-ref-list { margin-top: 8rpx; }
.code-ref { font-size: 24rpx; color: #1a73e8; padding: 8rpx 0; display: block; }

/* 面试题 */
.interview-section { margin: 24rpx 32rpx 0; }
.interview-title {
  font-size: 30rpx; font-weight: 700; color: #2d3748;
  padding: 0 0 16rpx;
}
.interview-card {
  background: #fff; border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.iq-header {
  display: flex; align-items: flex-start;
  padding: 28rpx 32rpx; gap: 16rpx;
}
.iq-header:active { background: #f7fafc; }
.level-badge {
  font-size: 22rpx; padding: 4rpx 16rpx;
  border-radius: 20rpx; flex-shrink: 0; margin-top: 4rpx;
}
.level-basic    { background: #e8f5e9; color: #388e3c; }
.level-advanced { background: #fff3e0; color: #f57c00; }
.level-expert   { background: #fce4ec; color: #c62828; }
.iq-question { font-size: 28rpx; font-weight: 600; color: #2d3748; flex: 1; line-height: 1.5; }
.iq-arrow { font-size: 24rpx; color: #a0aec0; margin-top: 4rpx; }
.iq-answer {
  padding: 0 32rpx 28rpx;
  font-size: 26rpx; color: #4a5568; line-height: 1.8;
  white-space: pre-wrap; border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
}
