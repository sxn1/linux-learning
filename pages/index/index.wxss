.container {
  min-height: 100vh;
  background: #f5f6fa;
}

/* banner */
.banner {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
  padding: 60rpx 40rpx 48rpx;
}
.banner-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
.banner-sub {
  font-size: 28rpx;
  color: #a0aec0;
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}
.search-bar {
  background: rgba(255,255,255,0.1);
  border-radius: 48rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.search-icon { font-size: 28rpx; }
.search-hint { color: #718096; font-size: 28rpx; }

/* 分区标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #718096;
  padding: 32rpx 32rpx 16rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* 网格 */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 0 32rpx 48rpx;
}
.grid-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.grid-item:active { opacity: 0.8; }
.item-icon  { font-size: 56rpx; }
.item-name  { font-size: 32rpx; font-weight: 700; color: #2d3748; margin-top: 12rpx; }
.item-en    { font-size: 22rpx; color: #a0aec0; margin-top: 4rpx; }
.item-count {
  font-size: 22rpx;
  color: #4a5568;
  background: #f7fafc;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
  margin-top: 12rpx;
}
.item-desc  { font-size: 22rpx; color: #718096; margin-top: 12rpx; line-height: 1.5; }

.loading { padding: 80rpx; text-align: center; }
.loading-text { color: #a0aec0; }
