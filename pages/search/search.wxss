.container { background: #f5f6fa; min-height: 100vh; }

/* 搜索框 */
.search-box {
  background: #fff; padding: 20rpx 32rpx;
  display: flex; align-items: center;
  border-bottom: 1rpx solid #f0f0f0; gap: 16rpx;
}
.search-input {
  flex: 1; font-size: 30rpx; color: #2d3748;
  background: #f7fafc; padding: 16rpx 24rpx;
  border-radius: 32rpx; height: 72rpx;
}
.clear-btn { font-size: 28rpx; color: #a0aec0; padding: 8rpx; }

/* 提示 */
.tip { text-align: center; padding: 80rpx 40rpx; color: #a0aec0; font-size: 28rpx; }

/* 结果 */
.result-count { font-size: 26rpx; color: #718096; padding: 20rpx 32rpx; }

/* 结果卡片（复用 list 样式）*/
.card {
  background: #fff; border-radius: 16rpx;
  margin: 0 32rpx 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.card:active { opacity: 0.85; }
.card-title { font-size: 30rpx; font-weight: 600; color: #2d3748; line-height: 1.4; }
.card-cat { font-size: 22rpx; color: #fff; background: #1a73e8; padding: 4rpx 14rpx; border-radius: 16rpx; display: inline-block; margin-top: 10rpx; }
.card-summary { font-size: 26rpx; color: #718096; margin-top: 12rpx; line-height: 1.5; }
.card-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.tag { font-size: 22rpx; color: #4a5568; background: #edf2f7; padding: 4rpx 14rpx; border-radius: 16rpx; }
